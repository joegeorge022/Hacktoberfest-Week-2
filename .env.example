# HustlePulse AI Environment Configuration

# Gemma Open-Weight Model Settings
# Options: 'auto' (checks Ollama first, then HF, then fallback), 'ollama', 'huggingface', 'fallback'
GEMMA_PROVIDER=auto
OLLAMA_BASE_URL=http://localhost:11434
GEMMA_MODEL=gemma2:2b
HF_TOKEN=your_huggingface_token_here
HF_MODEL_ID=google/gemma-2-2b-it

# Prior Labs TabPFN-3.5 Foundation Model
# Get your free non-commercial key at https://platform.priorlabs.ai
TABPFN_API_KEY=your_tabpfn_api_key_here

# ElevenLabs Voice Studio
# Get your API key at https://elevenlabs.io
ELEVENLABS_API_KEY=your_elevenlabs_api_key_here
ELEVENLABS_VOICE_ID=21m00Tcm4TlvDq8ikWAM

# Sentry Agent Tracing
SENTRY_DSN=your_sentry_dsn_here
ENVIRONMENT=development

# Server
HOST=0.0.0.0
PORT=8000
